+// Read just the requested frame bytes on a nonblocking socket.
+static int read_socks5_frame(struct eval *val, size_t required)
+{
+    while (val->auth_read < required) {
+        ssize_t n = recv(val->fd, val->auth_frame + val->auth_read,
+                required - val->auth_read, 0);
+        if (n < 0) {
+            int err = get_e();
+            if (err == EAGAIN || err == EWOULDBLOCK)
+                return 0;
+            if (err == EINTR)
+                continue;
+        }
+        if (n <= 0)
+            return -1;
+        val->auth_read += n;
+    }
+    return 1;
+}
+
+static int on_socks5_auth(struct eval *val)
+{
+    bool userpass = val->flag == FLAG_S5_AUTH;
+    char *frame = val->auth_frame;
+    int ready = read_socks5_frame(val, 2);
+    if (ready <= 0)
+        return ready;
+    if ((uint8_t)frame[0] != (userpass ? 1 : S_VER5))
+        return -1;
+    size_t required = 2 + (uint8_t)frame[1] + userpass;
+    if (userpass) {
+        ready = read_socks5_frame(val, required);
+        if (ready <= 0)
+            return ready;
+        required += (uint8_t)frame[required - 1];
+    }
+    ready = read_socks5_frame(val, required);
+    if (ready <= 0)
+        return ready;
+    int error = userpass
+        ? auth_socks5_userpass(val->fd, frame, required)
+        : auth_socks5(val->fd, frame, required);
+    memset(frame, 0, required);
+    val->auth_read = 0;
+    if (error)
+        return -1;
+    val->flag = userpass ? FLAG_S5 : FLAG_S5_AUTH;
+    return 0;
+}
