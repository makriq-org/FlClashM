+static int auth_socks5_userpass(int fd, const char *buffer, ssize_t n)
+{
+    uint8_t response[2] = { 0x01, 0x01 };
+    if (n >= 5 && (uint8_t)buffer[0] == 0x01) {
+        size_t user_len = (uint8_t)buffer[1];
+        size_t pass_offset = 2 + user_len;
+        if (user_len > 0 && pass_offset < (size_t)n) {
+            size_t pass_len = (uint8_t)buffer[pass_offset];
+            if (pass_len > 0 && pass_offset + 1 + pass_len == (size_t)n &&
+                    user_len == strlen(params.auth_user) &&
+                    pass_len == strlen(params.auth_pass) &&
+                    !memcmp(buffer + 2, params.auth_user, user_len) &&
+                    !memcmp(buffer + pass_offset + 1, params.auth_pass, pass_len)) {
+                response[1] = 0x00;
+            }
+        }
+    }
+    if (send(fd, (char *)response, sizeof(response), 0) < 0) {
+        uniperror("send");
+        return -1;
+    }
+    return response[1] == 0 ? 0 : -1;
+}
