+// Negotiation uses nonblocking sockets. Read only the current frame so
+// TCP fragmentation is harmless and following bytes stay queued.
+static int on_socks5_auth(struct eval *val)
+{
+    bool userpass = val->flag == FLAG_S5_AUTH;
+    char *frame = val->auth_frame;
+    size_t required = 2;
+    for (;;) {
+        if (val->auth_read >= required) {
+            if (required == 2) {
+                if ((uint8_t)frame[0] != (userpass ? 1 : S_VER5))
+                    return -1;
+                required += (uint8_t)frame[1] + userpass;
+                if (required > val->auth_read)
+                    continue;
+            }
+            if (userpass && required == 3 + (size_t)(uint8_t)frame[1]) {
+                required += (uint8_t)frame[required - 1];
+                if (required > val->auth_read)
+                    continue;
+            }
+            break;
+        }
+        ssize_t n = recv(val->fd, frame + val->auth_read,
+                required - val->auth_read, 0);
+        if (n < 0) {
+            int err = get_e();
+            if (err == EAGAIN || err == EWOULDBLOCK)
+                return 0;
+            if (err == EINTR)
+                continue;
+        }
+        if (n <= 0)
+            return -1;
+        val->auth_read += n;
+    }
+    int error = userpass
+        ? auth_socks5_userpass(val->fd, frame, required)
+        : auth_socks5(val->fd, frame, required);
+    memset(frame, 0, required);
+    val->auth_read = 0;
+    if (error)
+        return -1;
+    val->flag = userpass ? FLAG_S5 : FLAG_S5_AUTH;
+    return 0;
+}
