@@ -0,0 +1,21 @@
+package sing_tun
+
+import (
+	"errors"
+
+	M "github.com/metacubex/sing/common/metadata"
+)
+
+// ConnectionGuard is installed by an embedding application to enforce its own
+// per-flow TUN policy. It runs before DNS hijack, ICMP forwarding and rule
+// routing, and must not block: the packet path calls it synchronously.
+// A nil guard allows every flow.
+var ConnectionGuard func(network string, source, destination M.Socksaddr) bool
+
+// errConnectionRejected closes a guarded flow without entering the tunnel.
+var errConnectionRejected = errors.New("tun connection rejected by the app isolation policy")
+
+func allowConnection(network string, source, destination M.Socksaddr) bool {
+	guard := ConnectionGuard
+	return guard == nil || guard(network, source, destination)
+}
