<?xml version="1.0" encoding="utf-8"?>
<!-- The in-app zashboard webview fetches http://127.0.0.1:<port> (the core's
     external-controller). WebView enforces the app's cleartext policy — which
     since targetSdk 28 blocks plain HTTP even to loopback — so localhost must be
     whitelisted explicitly. Dart's own HttpClient bypasses this config entirely,
     so nothing else in the app is affected; cleartext to any other host stays
     blocked (platform default). -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
